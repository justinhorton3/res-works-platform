FROM python:3.12-slim
WORKDIR /workspace
COPY pyproject.toml requirements.txt ./
COPY src ./src
COPY api ./api
COPY reference ./reference
COPY projects ./projects
COPY tests ./tests
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir "pytest>=8.0" "httpx2>=0.1"
CMD ["python", "-m", "pytest", "-q"]
